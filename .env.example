# Copy to .env and fill in. NEVER commit .env.
# The live .env sits in public_html; .htaccess blocks it from being served.
DB_HOST="localhost"
DB_USER=""
DB_PASS=""
DB_NAME=""

# Stripe payment links for paid tiers
STRIPE_PAID_URL=""
STRIPE_PREMIUM_URL=""

# Google AdSense publisher id (ca-pub-...)
ADSENSE_PUB_ID=""

# reCAPTCHA v3 keys
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Authenticated SMTP for notification emails (create the mailbox in hPanel,
# e.g. noreply@recoverybusinesshub.com). Raw mail() silently fails on Hostinger.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# bcrypt hash for admin.php login
# php -r "echo password_hash('yourpassword', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=""
