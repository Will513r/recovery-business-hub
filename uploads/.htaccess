# ----------------------------------------------------------------------
# | Security: Block Script Execution & Access                          |
# ----------------------------------------------------------------------

# Deny access to any file with a script extension (case-insensitive)
<FilesMatch "(?i)\.(php[0-9]?|phtml|pl|py|jsp|asp|htm|shtml|sh|cgi)$">
    # Modern Apache 2.4 syntax
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    # Legacy Apache 2.2 syntax (fallback)
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Fallback: Serve files as plain text if they somehow bypass the block
AddType text/plain .php .phtml .php3 .php4 .php5 .pl .py .jsp .asp .htm .shtml .sh .cgi

# Deny directory listing to hide your uploaded files
Options -Indexes

# ----------------------------------------------------------------------
# | Performance: Caching & Compression                                 |
# ----------------------------------------------------------------------

# Cache uploaded images for 1 year in the user's browser
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Only apply gzip compression to SVGs (compressing JPGs/PNGs wastes server CPU)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>