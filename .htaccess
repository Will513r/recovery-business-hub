RewriteEngine On

# 0. Block access to dotfiles (.env holds DB credentials and API secrets)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 0.5 Serve the XML sitemap (robots.txt points to /sitemap.xml)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Remove .php extensions (e.g., /about instead of /about.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# 3. SEO-Friendly Business Profiles
RewriteRule ^business/([a-zA-Z0-9-]+)/?$ profile.php?slug=$1 [L,QSA]

# 4. FIX FOR FACEBOOK SCRAPER (Canonical URL)
RewriteCond %{QUERY_STRING} ^id=(\d+)$ [NC]
RewriteRule ^profile\.php$ /business/%1/? [R=301,L]

# ----------------------------------------------------------------------
# | Security Headers                                                   |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent clickjacking by restricting where the site can be framed
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevent browsers from incorrectly detecting non-scripts as scripts
    Header set X-Content-Type-Options "nosniff"

    # Enable XSS filtering in legacy browsers that support it
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# ----------------------------------------------------------------------
# | Browser Caching (Performance)                                      |
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Cache static assets for 1 year to improve load times
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Cache styles and scripts for 1 year
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Cache fonts for 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>